# docker-compose.quickstart.yml 使用的配置。复制为 .env.quickstart 后填写。
# 生成密钥：
#   python -c "import secrets; print(secrets.token_hex(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
ENCRYPTION_KEY=

# 任意 OpenAI 兼容接口（需支持 tool calling 效果最佳）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 可选
# AGENT_BRIEF_ENABLED=true   # 每天 AGENT_BRIEF_HOUR 点（北京时间）自动生成并推送简报
# AGENT_TRIAL_DAILY_LIMIT=5  # /try 免登录试用：每个 IP 每天次数
