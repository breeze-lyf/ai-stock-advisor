# Backend
DATABASE_URL=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Required security settings — generate with:
#   SECRET_KEY:     python -c "import secrets; print(secrets.token_hex(32))"
#   ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
ENCRYPTION_KEY=

# Agent (P1) — system-default OpenAI-compatible relay (e.g. 致拓 relay), used when the
# user has no BYOK model/key. Base URL should include the /v1 suffix.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# AGENT_MAX_STEPS=8
# AGENT_LLM_TIMEOUT_SECONDS=90
# AGENT_TOOL_TIMEOUT_SECONDS=60
# AGENT_TOOL_RESULT_MAX_CHARS=6000

# Agent (P2) — 个人投资智能体功能开关
# AGENT_BRIEF_ENABLED=false        # 定时每日简报（默认关闭）；开启后每天 AGENT_BRIEF_HOUR 点（北京时间）生成+推送
# AGENT_BRIEF_HOUR=8
# AGENT_BRIEF_MAX_USERS=200        # 单次定时任务最多处理的用户数
# AGENT_ADVICE_REVIEW_ENABLED=true # 每天 17:00（北京时间）复盘到期建议
# AGENT_TRIAL_ENABLED=true         # /try 免登录试用（只读工具，消耗系统 LLM 额度）
# AGENT_TRIAL_DAILY_LIMIT=5        # 每个 IP 每天试用次数（Redis 计数；nginx 需设置 X-Real-IP）
# AGENT_TRIAL_MAX_STEPS=4
# FEATURE_BILLING_ENABLED=false    # 订阅/计费（后端 public-config 暴露）
# 注意：推送渠道的 URL/密钥用 ENCRYPTION_KEY 加密存储，未配置 ENCRYPTION_KEY 时无法添加推送渠道。

# Optional — Redis for caching and distributed scheduler locks
# REDIS_URL=redis://localhost:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# 前端功能开关（构建时生效，默认隐藏非核心页面；设为 true 重新显示）
# NEXT_PUBLIC_FEATURE_BILLING=false
# NEXT_PUBLIC_FEATURE_QUANT=false
# NEXT_PUBLIC_FEATURE_PAPER_TRADING=false
# NEXT_PUBLIC_FEATURE_CALENDAR=false
# NEXT_PUBLIC_FEATURE_RADAR=false
# NEXT_PUBLIC_FEATURE_SCREENER=false
# NEXT_PUBLIC_FEATURE_TRIAL=true

# Environment flag for data source routing
# Set to "true" when running on server (e.g., Alibaba Cloud) without proxy
# Set to "false" (default) for local development with proxy
# This affects US stock data source selection:
#   - Server (true): Uses AkShare (more reliable without proxy)
#   - Local (false): Uses YFinance (better US stock coverage with proxy)
IS_SERVER_ENV=false

# Cloudflare Worker Proxy (optional - for bypassing Yahoo Finance restrictions)
# Deploy the worker script from cloudflare-worker/yahoo-proxy.js first
# CLOUDFLARE_WORKER_URL=https://yahoo-proxy.your-account.workers.dev
# CLOUDFLARE_WORKER_KEY=your-secret-key-here
